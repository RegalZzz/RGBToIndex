<Window x:Class="RGB2Index.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RGB2Index"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="真彩色转索引色查询器" Height="250" Width="240">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1.6*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                 TextWrapping="Wrap" Text="" Width="35" Height="25" Name="RGB_R" GotFocus="RGB_GotFocus">
            <TextBox.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Label Grid.Row="0" Grid.Column="0" Content="R" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                 TextWrapping="Wrap" Text="" Width="34" Height="25" Name="RGB_G" GotFocus="RGB_GotFocus"> 
            <TextBox.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Label Grid.Row="0" Grid.Column="1" Content="G" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
        <TextBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                 TextWrapping="Wrap" Name="RGB_B" GotFocus="RGB_GotFocus"
                 Text="" Width="35" Height="25" >
            <TextBox.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Label Grid.Row="0" Grid.Column="2" Content="B" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,0" />
        <Rectangle Name="RecRGB" Grid.Row="2" Grid.Column="0" Visibility="Hidden" HorizontalAlignment="right" Height="27" Width="27"
                   Stroke="LightGray" VerticalAlignment="Center" />
        <Rectangle Name="RecIndex" Grid.Row="2" Grid.Column="2" Visibility="Hidden" HorizontalAlignment="Left" Height="27" Width="27"
           Stroke="LightGray" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Name="RecRGB_Num" Visibility="Hidden" HorizontalAlignment="Right" TextWrapping="Wrap" Text="" 
                   VerticalAlignment="Top" FontSize="10"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Name="RecIndex_Num" Visibility="Hidden" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" 
           VerticalAlignment="Top" FontSize="10"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Name="SameOrSimilar" HorizontalAlignment="Center" TextWrapping="Wrap" Text="" 
                   VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
        <Label Grid.Row="4" Grid.Column="0" Content="索引色" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
         TextWrapping="Wrap" Name="IndexNum"
         Text="" VerticalAlignment="Center" Width="72" Height="25">
            <TextBox.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Button Grid.Row="5" Grid.ColumnSpan="3" Name="confirm" Content="转换"  FontSize="13" Width="80" Height="30" HorizontalAlignment="Center"
                BorderBrush="#FF92A4B5" Background="#FF5996CB" Foreground="#FFF9F9F9" FontWeight="Bold" Click="confirm_Click"/>
        
    </Grid>
</Window>
